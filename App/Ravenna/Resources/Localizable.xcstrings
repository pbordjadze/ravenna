{
  "sourceLanguage" : "en",
  "strings" : {
    "A Calmer Way to Paint" : {
      "comment" : "Title of the tip at the More menu of the painting screen about Zen Mode",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Calmer Way to Set Tiles"
          }
        }
      }
    },
    "A Page Is Waiting" : {
      "comment" : "Title of the tip in the gallery’s Ready to Paint section, shown on the first visit, once the starter pages are in view",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mosaic Is Waiting"
          }
        }
      }
    },
    "A scene a step" : {
      "comment" : "Making-of options: the build in scenes, a card each",
      "extractionState" : "manual"
    },
    "About" : {
      "comment" : "Header of the About section in Settings",
      "extractionState" : "manual"
    },
    "Acknowledgements" : {
      "comment" : "Settings row, and the title of the screen it opens, crediting the sample pictures, artwork, and the code, models and methods behind the template engine",
      "extractionState" : "manual"
    },
    "Adjust" : {
      "comment" : "Create flow button under the mosaic's title: shows the recipe's settings (Pieces and Ground), or folds them away again",
      "extractionState" : "manual"
    },
    "Settings hidden" : {
      "comment" : "VoiceOver value of the create flow's Adjust button while the settings are folded away",
      "extractionState" : "manual"
    },
    "Settings shown" : {
      "comment" : "VoiceOver value of the create flow's Adjust button while the settings show",
      "extractionState" : "manual"
    },
    "acknowledgements.faceLandmarks.usage" : {
      "comment" : "What a credited third-party method or library is used for in Ravenna's mosaic engine (face landmarks); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds a face’s eyes, brows, nose and lips, which are set first, as pieces of their own."
          }
        }
      }
    },
    "acknowledgements.hedModel.mosaic.usage" : {
      "comment" : "What a credited machine-learning model is used for (ControlNet's HED edge detector) in Ravenna; shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds the outlines of a photo, which the mosaic’s strands of tiles follow."
          }
        }
      }
    },
    "acknowledgements.skeletonize.usage" : {
      "comment" : "What a credited third-party method or library is used for in Ravenna's mosaic engine (scikit-image's thinning table); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thins a photo’s outlines to the single rows its strands of tiles are laid along."
          }
        }
      }
    },
    "acknowledgements.zhangSuen.usage" : {
      "comment" : "What a credited third-party method or library is used for in Ravenna's mosaic engine (Zhang–Suen thinning); shown in Settings under Acknowledgements",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thins the outlines to single rows, so a strand of tiles runs along each."
          }
        }
      }
    },
