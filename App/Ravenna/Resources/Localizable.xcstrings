{
  "sourceLanguage" : "en",
  "strings" : {
    "A Calmer Way to Paint" : {
      "comment" : "Title of the tip at the More menu of the painting screen about Zen Mode",
      "extractionState" : "manual"
    },
    "A Page Is Waiting" : {
      "comment" : "Title of the tip in the gallery’s Ready to Paint section, shown on the first visit, once the starter pages are in view",
      "extractionState" : "manual"
    },
    "About" : {
      "comment" : "Header of the About section in Settings",
      "extractionState" : "manual"
    },
    "Acknowledgements" : {
      "comment" : "Settings row, and the title of the screen it opens, crediting the sample pictures, artwork, and the code, models and methods behind the template engine",
      "extractionState" : "manual"
    },
    "Bend Line" : {
      "comment" : "Refine screen: the tool that moves a drawn line by dragging it, bending it near where it is held; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Blank" : {
      "comment" : "Refine screen, Start From: a blank start, the photo as one area of one paint, which the painter's lines then divide and the paint tools color",
      "extractionState" : "manual"
    },
    "Brings back the other controls" : {
      "comment" : "Accessibility hint of the painting screen's progress ring while the top bar is quiet (faded to Back, the ring and Hint): a tap brings back Photo, Undo and More",
      "extractionState" : "manual"
    },
    "Bucket" : {
      "comment" : "Refine screen: the paint bucket tool, whose tap gives an area the current paint; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Cell Edge" : {
      "comment" : "Refine screen: the tool that divides an area in two with a stroke and draws no line, both parts keeping their paint; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Cells" : {
      "comment" : "Refine screen: the group of tools that shape the painting's areas (Select, Cell Edge, Fill Shape); a section of the tool rail on iPad, a tab above the tools on iPhone",
      "extractionState" : "manual"
    },
    "Change Color" : {
      "comment" : "Refine screen, Select's bar: a button that opens the selected area's card, where it takes another color or paint",
      "extractionState" : "manual"
    },
    "Color" : {
      "comment" : "Refine screen, Colors: VoiceOver label of the color picker that gives the paint picked a new color",
      "extractionState" : "manual"
    },
    "Color from Photo" : {
      "comment" : "Refine screen, the Pen's options: a switch; when on, the parts of an area a drawn line divides take the photo's colors there",
      "extractionState" : "manual"
    },
    "Draw Your Own Lines" : {
      "comment" : "Title of the gentle tip in Refine, at the Pen, said once when Refine first opens: how its canvas takes drawing",
      "extractionState" : "manual"
    },
    "Draw lines exactly as you draw them. Two fingers zoom and move, and a two‑finger tap undoes." : {
      "comment" : "Message of the tip titled Draw Your Own Lines in Refine (the two-finger tap undoes the last change)",
      "extractionState" : "manual"
    },
    "Edit Paint" : {
      "comment" : "Refine screen: the tool that gives the current paint a new color everywhere it is used; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Eyedropper" : {
      "comment" : "Refine screen: the tool whose tap picks an area's paint, or the photo's color, as the current paint; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Fill Shape" : {
      "comment" : "Refine screen: the tool whose tap makes a closed shape of the drawing an area of its own; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Generated" : {
      "comment" : "Refine screen, Start From: the template the app made from the photo (the default)",
      "extractionState" : "manual"
    },
    "Goes Well With" : {
      "comment" : "Tool Guide: heading of a page's buttons to the pages of tools that go with this one",
      "extractionState" : "manual"
    },
    "Good to Know" : {
      "comment" : "Tool Guide: heading of a page's notes",
      "extractionState" : "manual"
    },
    "Hexagon" : {
      "comment" : "Refine screen, Shapes: the figure a drag draws as a six-sided shape",
      "extractionState" : "manual"
    },
    "How to Use It" : {
      "comment" : "Tool Guide: heading of a page's numbered steps",
      "extractionState" : "manual"
    },
    "Ink" : {
      "comment" : "Refine screen: the group of tools that draw and erase the lines the painter sees (Pen, Shapes, Eraser, Line Eraser); a section of the tool rail on iPad, a tab above the tools on iPhone",
      "extractionState" : "manual"
    },
    "Line Eraser" : {
      "comment" : "Refine screen: the tool that rubs lines out, or takes a whole line out with a tap; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Merge" : {
      "comment" : "Refine screen: the tool that joins the areas a drag crosses into one; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Merge Into Current Paint" : {
      "comment" : "Refine screen, Edit Paint: VoiceOver action on a paint's swatch that merges that paint into the current one (its areas take the current paint and it leaves the palette)",
      "extractionState" : "manual"
    },
    "Move Edge" : {
      "comment" : "Refine screen: the tool that drags the boundary between two areas to change their shapes; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Move Number" : {
      "comment" : "Refine screen: the tool that drags an area's number to another spot in the area; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "New Paint" : {
      "comment" : "Refine screen, the palette: VoiceOver label of the color picker at its end, which picks any color as the current paint, and of the swatch of a current color no paint has yet",
      "extractionState" : "manual"
    },
    "Numbers" : {
      "comment" : "Refine screen: the group of tools about the areas' numbers (Move Number); a section of the tool rail on iPad, a tab above the tools on iPhone",
      "extractionState" : "manual"
    },
    "Only This Area" : {
      "comment" : "Refine screen, an area's card (a long press on an area): the label of the color picker that gives the pressed area a paint of its own, while the other areas of its paint keep theirs",
      "extractionState" : "manual"
    },
    "Or Use a Paint" : {
      "comment" : "Refine screen, an area's card: the caption over a row of the painting's paints, one of which the pressed area can take instead",
      "extractionState" : "manual"
    },
    "Paint Brush" : {
      "comment" : "Refine screen: the tool that paints the current paint where it is dragged, making or growing areas; its name in the tool rail and its VoiceOver label",
      "extractionState" : "manual"
    },
    "Photo Behind" : {
      "comment" : "Refine screen: what shows beneath the drawing, one of Painting, Paper, Photo and Photo Behind (the photo with the painting faint over it, for tracing); a slider sets how faint",
      "extractionState" : "manual"
    },
    "Pick a paint in the palette, or tap an area." : {
      "comment" : "Refine screen, Edit Paint: shown in place of the color picker before a paint is picked",
      "extractionState" : "manual"
    },
    "Practice" : {
      "comment" : "Tool Guide: VoiceOver label of a page's practice canvas, where the tool can be tried on a practice picture",
      "extractionState" : "manual"
    },
    "refine.areaMade" : {
      "comment" : "VoiceOver announcement on the Refine screen when a line the painter drew closed off an area of its own",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New area"
          }
        }
      }
    },
    "refine.brush.size" : {
      "comment" : "Refine screen, the Paint Brush's options: VoiceOver value of its Size slider, the brush's radius on screen in points; the argument is the number",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
